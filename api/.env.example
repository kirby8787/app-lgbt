# Copiar a .env en el servidor y llenar. NUNCA subir .env al repositorio.
NODE_ENV=production
PORT=3000
SERVICE_TIMEZONE=America/Mexico_City

# Base de datos (Hostinger MySQL)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10

# Tokens
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
CRON_SECRET=

# Correo (SMTP de Hostinger)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Almacenamiento de fotos: disk | s3
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./uploads
PUBLIC_MEDIA_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Tiempo real
REALTIME_DRIVER=ably
ABLY_API_KEY=

# Push
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
APNS_BUNDLE_ID=
HMS_APP_ID=
HMS_APP_SECRET=

# Inicio de sesión social
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# IA (descripción del perfil)
AI_DRIVER=
AI_API_KEY=
AI_MODEL=

# Moderación de imágenes
MODERATION_DRIVER=sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Pagos
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_KEY_P8=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
HUAWEI_IAP_CLIENT_ID=
HUAWEI_IAP_CLIENT_SECRET=
